---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;

const navLinks = [
  { label: '首页', href: `${base}/` },
  { label: '知识点', href: `${base}/knowledge` },
  { label: '真题', href: `${base}/ncee` },
  { label: '专题', href: `${base}/topics` },
];

const currentPath = Astro.url.pathname;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="高中地理知识库 — 覆盖人教版 2019 全册 + 2012-2026 高考地理真题" />
    <title>{title} | Geography_HS</title>
  </head>
  <body class="min-h-screen flex flex-col bg-surface text-content">
    <header class="bg-surface-card shadow-sm">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href={`${base}/`} class="text-xl font-bold text-brand hover:text-brand-hover transition">
          Geography_HS — 高中地理知识库
        </a>
        <nav class="flex gap-6">
          {navLinks.map(({ label, href }) => (
            <a
              href={href}
              class:list={[
                'text-sm font-medium transition',
                currentPath === href || (href !== '/' && currentPath.startsWith(href))
                  ? 'text-brand border-b-2 border-brand'
                  : 'text-content-muted hover:text-brand-text',
              ]}
            >
              {label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-1 max-w-5xl mx-auto px-4 py-8 w-full">
      <slot />
    </main>

    <footer class="bg-surface-card border-t border-border mt-auto">
      <div class="max-w-5xl mx-auto px-4 py-6 text-center text-sm text-content-muted">
        &copy; {new Date().getFullYear()} Geography_HS — 高中地理知识库 &middot; MIT License
      </div>
    </footer>
  </body>
</html>
