---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';

export async function getStaticPaths() {
  const knowledgePoints = await getCollection('knowledge-points');

  return knowledgePoints.map(kp => ({
    params: { kpId: kp.id },
    props: { kp }
  }));
}

const { kp } = Astro.props;

// 查找相关真题
const nceeQuestions = await getCollection('textbooks/ncee');
const relatedQuestions = nceeQuestions.filter(q =>
  q.data.knowledge_points.includes(kp.id)
);

// 分类映射
const categoryNames = {
  natural: '自然地理',
  human: '人文地理',
  regional: '区域发展',
  world_china: '世界与中国',
  tools: '工具方法'
};

// 考频映射
const frequencyNames = {
  high: '高频',
  medium: '中频',
  low: '低频'
};

const frequencyColors = {
  high: 'bg-red-100 text-red-700',
  medium: 'bg-amber-100 text-amber-700',
  low: 'bg-green-100 text-green-700'
};

// Markdown 渲染配置
marked.setOptions({
  breaks: true,
  gfm: true,
});
---

<BaseLayout title={`${kp.data.name} - 知识点`}>
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/Geography_HS/knowledge/" class="hover:text-green-600">知识点</a>
    <span class="mx-2">›</span>
    <span class="text-gray-800">{kp.data.name}</span>
  </nav>

  <h1 class="text-3xl font-bold mb-2">{kp.data.name}</h1>
  
  <div class="flex gap-2 mb-6">
    <span class="text-xs px-2 py-1 rounded bg-blue-100 text-blue-700">
      {categoryNames[kp.data.category]}
    </span>
    <span class={`text-xs px-2 py-1 rounded ${frequencyColors[kp.data.exam_frequency]}`}>
      {frequencyNames[kp.data.exam_frequency]}考点
    </span>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
    <h2 class="text-lg font-semibold mb-3">📖 知识点阐述</h2>
    <div class="prose prose-sm max-w-none text-gray-700 markdown-content" set:html={marked.parse(kp.data.description)} />
  </div>

  {kp.data.key_concepts && kp.data.key_concepts.length > 0 && (
    <div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
      <h2 class="text-lg font-semibold mb-4">🔑 核心概念</h2>
      <div class="space-y-6">
        {kp.data.key_concepts.map((concept: any) => (
          <div class="border-l-4 border-green-500 pl-4">
            <h3 class="text-base font-semibold text-gray-800 mb-2">{concept.title}</h3>

            {concept.definition && (
              <div class="mb-2">
                <span class="text-sm font-medium text-gray-600">定义：</span>
                <div class="text-sm text-gray-700 markdown-content inline" set:html={marked.parse(concept.definition)} />
              </div>
            )}

            {concept.explanation && (
              <div class="mb-2">
                <span class="text-sm font-medium text-gray-600">详解：</span>
                <div class="text-sm text-gray-700 leading-relaxed markdown-content" set:html={marked.parse(concept.explanation)} />
              </div>
            )}

            {concept.example && (
              <div class="mb-2 bg-blue-50 rounded p-3">
                <span class="text-sm font-medium text-blue-700">📝 举例：</span>
                <div class="text-sm text-blue-900 mt-1 markdown-content" set:html={marked.parse(concept.example)} />
              </div>
            )}

            {concept.formula && (
              <div class="bg-yellow-50 rounded p-3">
                <span class="text-sm font-medium text-yellow-700">📐 公式：</span>
                <p class="text-sm text-yellow-900 font-mono mt-1">{concept.formula}</p>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  {kp.data.common_mistakes && kp.data.common_mistakes.length > 0 && (
    <div class="bg-yellow-50 rounded-lg border border-yellow-200 p-6 mb-6">
      <h2 class="text-lg font-semibold mb-3 text-yellow-800">⚠️ 易错点</h2>
      <div class="space-y-3 text-yellow-900">
        {kp.data.common_mistakes.map(mistake => (
          <div class="text-sm markdown-content" set:html={marked.parse(mistake)} />
        ))}
      </div>
    </div>
  )}

  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <h2 class="text-lg font-semibold mb-4">
      📝 相关真题
      <span class="text-sm font-normal text-gray-500 ml-2">({relatedQuestions.length} 道)</span>
    </h2>

    {relatedQuestions.length === 0 ? (
      <p class="text-gray-500">暂无相关真题</p>
    ) : (
      <div class="space-y-3">
        {relatedQuestions.slice(0, 10).map(q => (
          <a
            href={`/Geography_HS/ncee/${q.data.paper_code}/${String(q.data.question_number).padStart(2, '0')}/`}
            class="block p-4 border border-gray-200 rounded hover:border-green-400 hover:shadow-sm transition"
          >
            <div class="flex items-center justify-between">
              <div>
                <span class="font-medium text-gray-800">{q.data.paper}</span>
                <span class="text-gray-500 ml-2">第{q.data.question_number}题</span>
              </div>
              <span class={`text-xs px-2 py-1 rounded ${
                q.data.difficulty === 'basic' ? 'bg-green-100 text-green-700' :
                q.data.difficulty === 'medium' ? 'bg-amber-100 text-amber-700' :
                'bg-red-100 text-red-700'
              }`}>
                {q.data.difficulty === 'basic' ? '基础' : q.data.difficulty === 'medium' ? '中等' : '困难'}
              </span>
            </div>
            <div class="text-sm text-gray-500 mt-1">{q.data.year}年 · {q.data.score}分</div>
          </a>
        ))}
        {relatedQuestions.length > 10 && (
          <p class="text-sm text-gray-500 text-center mt-4">
            还有 {relatedQuestions.length - 10} 道相关真题...
          </p>
        )}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .markdown-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.875rem;
  }
  .markdown-content :global(th) {
    background-color: #f0fdf4;
    border: 1px solid #d1d5db;
    padding: 0.5rem 0.75rem;
    text-align: left;
    font-weight: 600;
    color: #1f2937;
  }
  .markdown-content :global(td) {
    border: 1px solid #d1d5db;
    padding: 0.5rem 0.75rem;
    color: #374151;
  }
  .markdown-content :global(tr:nth-child(even)) {
    background-color: #f9fafb;
  }
  .markdown-content :global(ul),
  .markdown-content :global(ol) {
    padding-left: 1.5rem;
    margin: 0.5rem 0;
  }
  .markdown-content :global(li) {
    margin: 0.25rem 0;
  }
  .markdown-content :global(strong) {
    color: #dc2626;
    font-weight: 600;
  }
  .markdown-content :global(blockquote) {
    border-left: 4px solid #10b981;
    padding-left: 1rem;
    margin: 0.75rem 0;
    color: #4b5563;
    background-color: #f0fdf4;
    padding: 0.75rem 1rem;
    border-radius: 0.25rem;
  }
  .markdown-content :global(p) {
    margin: 0.5rem 0;
  }
  .markdown-content :global(h1),
  .markdown-content :global(h2),
  .markdown-content :global(h3),
  .markdown-content :global(h4) {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
</style>
