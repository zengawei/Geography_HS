---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Badge from '../../../components/Badge.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';

export async function getStaticPaths() {
  const knowledgePoints = await getCollection('knowledge-points');
  return knowledgePoints.map(kp => ({
    params: { kpId: kp.id },
    props: { kp }
  }));
}

const { kp } = Astro.props;
const data = kp.data;

const nceeEntries = await getCollection('textbooks/ncee');
const relatedQuestions = nceeEntries.filter(entry =>
  !entry.data.is_deprecated &&
  entry.data.knowledge_points.includes(data.id)
);
relatedQuestions.sort((a, b) => b.data.year - a.data.year);

const categoryInfo: Record<string, { name: string; icon: string; badgeVariant: string }> = {
  natural:      { name: '自然地理',   icon: '🌿', badgeVariant: 'category-natural' },
  human:        { name: '人文地理',   icon: '👥', badgeVariant: 'category-human' },
  regional:     { name: '区域发展',   icon: '🗺️', badgeVariant: 'category-regional' },
  world_china:  { name: '世界与中国', icon: '🌏', badgeVariant: 'category-world_china' },
  tools:        { name: '工具方法',   icon: '🧭', badgeVariant: 'category-tools' },
};
const category = categoryInfo[data.category];

const freqVariant: Record<string, string> = { high: 'freq-high', medium: 'freq-medium', low: 'freq-low' };
const freqLabel: Record<string, string> = { high: '🔥 高频考点', medium: '📊 中频考点', low: '低频考点' };

marked.setOptions({ breaks: true, gfm: true });

function processCallouts(html: string): string {
  return html.replace(/<blockquote>\s*([\s\S]*?)<\/blockquote>/g, (match, inner: string) => {
    const text = inner.replace(/<[^>]+>/g, '').trim();
    let type = 'note';
    if (/^[✅📌✨]/u.test(text))       type = 'tip';
    else if (/^💡/u.test(text))         type = 'note';
    else if (/^⚠️?/u.test(text))        type = 'warning';
    else if (/^[📝📋]/u.test(text))     type = 'template';
    else return match;

    const cls = type === 'tip' ? 'callout callout-tip'
            : type === 'warning' ? 'callout callout-warning'
            : type === 'template' ? 'callout callout-template'
            : 'callout callout-note';

    return `<div class="${cls}">${inner}</div>`;
  });
}

function md(text: string): string {
  return processCallouts(marked.parse(text) as string);
}
---

<BaseLayout title={`${data.name} — Geography_HS`}>

  <div class="mb-6">
    <a href={`${import.meta.env.BASE_URL}/knowledge`}
       class="text-brand-text hover:text-brand-hover text-sm font-medium">
      ← 返回知识点总览
    </a>
  </div>

  <header class="bg-surface-card rounded-card shadow-card border border-border-card p-6 mb-10">
    <h1 class="text-3xl font-extrabold text-content-title mb-3 tracking-tight">{data.name}</h1>
    <div class="flex flex-wrap items-center gap-2 mb-5">
      <Badge variant={category.badgeVariant as any}>{category.icon} {category.name}</Badge>
      <Badge variant={(freqVariant[data.exam_frequency] ?? 'freq-low') as any}>
        {freqLabel[data.exam_frequency] ?? '低频考点'}
      </Badge>
    </div>
    <div class="text-content leading-relaxed markdown-content" set:html={md(data.description)} />
  </header>

  <section class="mb-12">
    <h2 class="text-2xl font-bold text-content-title mb-6">核心概念</h2>
    <div class="space-y-6">
      {data.key_concepts.map((concept: any) => {
        const isDetailed = typeof concept === 'object';
        const title = isDetailed ? concept.title : concept;
        const definition = isDetailed ? concept.definition : null;
        const explanation = isDetailed ? concept.explanation : null;
        const example = isDetailed ? concept.example : null;
        const formula = isDetailed ? concept.formula : null;

        return (
          <div class="bg-surface-card rounded-card shadow-card border border-border-card overflow-hidden">
            <div class="border-l-4 border-brand bg-brand-bg px-5 py-3">
              <h3 class="font-bold text-content-title text-lg">{title}</h3>
            </div>
            <div class="p-5 space-y-4">
              {definition && (
                <p class="text-content-muted text-sm leading-relaxed markdown-content" set:html={md(definition)} />
              )}
              {explanation && (
                <div>
                  <h4 class="text-sm font-semibold text-content-muted uppercase tracking-wider mb-2">详解</h4>
                  <div class="text-content leading-relaxed markdown-content" set:html={md(explanation)} />
                </div>
              )}
              {example && (
                <div class="bg-brand-bg rounded-card-sm p-4 border border-brand-light">
                  <h4 class="text-sm font-semibold text-brand mb-1">📝 举例</h4>
                  <div class="text-sm text-brand-hover leading-relaxed markdown-content" set:html={md(example)} />
                </div>
              )}
              {formula && (
                <div class="bg-amber-50 rounded-card-sm p-4 border border-amber-100">
                  <h4 class="text-sm font-semibold text-amber-700 mb-1">📐 公式</h4>
                  <p class="text-sm text-amber-900 font-mono">{formula}</p>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  {data.common_mistakes && data.common_mistakes.length > 0 && (
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-content-title mb-4">⚠️ 常见误区</h2>
      <div class="bg-callout-mistake-bg border border-callout-mistake-border rounded-card p-6 space-y-4">
        {data.common_mistakes.map(mistake => (
          <div class="text-sm leading-relaxed markdown-content" set:html={md(mistake)} />
        ))}
      </div>
    </section>
  )}

  {data.textbook_refs && data.textbook_refs.length > 0 && (
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-content-title mb-4">📚 教材关联</h2>
      <div class="bg-surface-card rounded-card shadow-card border border-border-card p-5">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {data.textbook_refs.map((ref: any) => (
            <div class="bg-surface rounded-card-sm p-3 text-sm border border-border-card">
              <div class="font-semibold text-content-title">
                {ref.textbook === 'required-1' ? '必修第一册' :
                 ref.textbook === 'required-2' ? '必修第二册' :
                 ref.textbook === 'selective-1' ? '选择性必修1' :
                 ref.textbook === 'selective-2' ? '选择性必修2' : '选择性必修3'}
              </div>
              <div class="text-content-muted mt-0.5">
                第 {ref.chapter} 章{ref.section ? ` 第 ${ref.section} 节` : ''}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {data.related_points && data.related_points.length > 0 && (
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-content-title mb-4">🔗 相关知识点</h2>
      <div class="flex flex-wrap gap-2">
        {data.related_points.map((relatedId: string) => (
          <a href={`${import.meta.env.BASE_URL}/knowledge/${relatedId}`}
             class="px-4 py-1.5 bg-brand-bg text-brand-text rounded-full text-sm font-medium
                    hover:bg-brand-light transition border border-brand-light">
            {relatedId}
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mb-8">
    <h2 class="text-2xl font-bold text-content-title mb-2">
      📝 相关真题
      <span class="text-base font-normal text-content-muted ml-1">({relatedQuestions.length} 道)</span>
    </h2>

    {relatedQuestions.length === 0 ? (
      <p class="text-content-muted py-4">暂无相关真题</p>
    ) : (
      <div class="space-y-2">
        {relatedQuestions.map((entry, idx) => {
          const q = entry.data;
          return (
            <a href={`${import.meta.env.BASE_URL}/ncee/${q.paper_code}/${String(q.question_number).padStart(2, '0')}`}
               class:list={[
                 'block bg-surface-card hover:bg-surface-hover rounded-card-sm p-4 border border-border transition',
                 idx >= 20 && 'hidden question-extra'
               ]}>
              <div class="flex items-center justify-between">
                <div>
                  <div class="font-semibold text-content-title">{q.paper}</div>
                  <div class="text-sm text-content-muted mt-0.5">
                    第 {q.question_number} 题 ·
                    {q.question_type === 'choice' ? '选择题' :
                     q.question_type === 'comprehensive' ? '综合题' :
                     q.question_type === 'elective' ? '选做题' : '填空题'}
                  </div>
                </div>
                <div class="text-right flex items-center gap-3">
                  <span class="text-sm text-content-muted">{q.year} 年</span>
                  <Badge variant={`diff-${q.difficulty}` as any}>
                    {q.difficulty === 'basic' ? '基础' : q.difficulty === 'medium' ? '中等' : '困难'}
                  </Badge>
                </div>
              </div>
            </a>
          );
        })}

        {relatedQuestions.length > 20 && (
          <div class="text-center pt-3">
            <button class="toggle-questions-btn text-sm text-brand-text hover:text-brand-hover cursor-pointer font-medium">
              展开显示全部 {relatedQuestions.length} 道真题 ▼
            </button>
          </div>
        )}
      </div>
    )}
  </section>

</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('.toggle-questions-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const section = btn.closest('section');
      const extras = section.querySelectorAll('.question-extra');
      const expanded = btn.classList.contains('expanded');
      const total = extras.length + 20;
      extras.forEach(el => el.classList.toggle('hidden', expanded));
      btn.textContent = expanded ? `展开显示全部 ${total} 道真题 ▼` : '收起 ▲';
      btn.classList.toggle('expanded', !expanded);
    });
  });
</script>
