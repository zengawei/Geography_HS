---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import Badge from '../../components/Badge.astro';
import { getCollection } from 'astro:content';

const knowledgePoints = await getCollection('knowledge-points');

const byCategory = knowledgePoints.reduce((acc, kp) => {
  const category = kp.data.category;
  if (!acc[category]) acc[category] = [];
  acc[category].push(kp);
  return acc;
}, {});

const categoryInfo: Record<string, { name: string; icon: string; badge: string }> = {
  natural:      { name: '自然地理',   icon: '🌿', badge: 'category-natural' },
  human:        { name: '人文地理',   icon: '👥', badge: 'category-human' },
  regional:     { name: '区域发展',   icon: '🗺️', badge: 'category-regional' },
  world_china:  { name: '世界与中国', icon: '🌏', badge: 'category-world_china' },
  tools:        { name: '工具方法',   icon: '🧭', badge: 'category-tools' },
};

const freqBadge: Record<string, string> = { high: 'freq-high', medium: 'freq-medium', low: 'freq-low' };
const freqLabel:  Record<string, string> = { high: '高频', medium: '中频', low: '低频' };
---

<BaseLayout title="知识点总览 — Geography_HS">
  <h1 class="text-3xl font-bold text-content-title mb-2">知识点总览</h1>
  <p class="text-content-muted mb-8">共 {knowledgePoints.length} 个知识点，按五大类别组织</p>

  <div class="space-y-8">
    {Object.entries(categoryInfo).map(([key, info]) => {
      const kps = byCategory[key] || [];
      return (
        <Card>
          <div class="flex items-center gap-3 mb-5">
            <span class="text-3xl">{info.icon}</span>
            <h2 class="text-2xl font-bold text-content-title">{info.name}</h2>
            <Badge variant={info.badge as any}>{kps.length} 个</Badge>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {kps.map(kp => (
              <a href={`${import.meta.env.BASE_URL}/knowledge/${kp.data.id}`}
                 class="block bg-surface hover:bg-surface-hover rounded-card-sm p-4 border border-border transition">
                <div class="font-semibold text-content-title mb-2">{kp.data.name}</div>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-content-muted line-clamp-2">{kp.data.description.slice(0, 60)}...</span>
                  <Badge variant={(freqBadge[kp.data.exam_frequency] ?? 'freq-low') as any}>
                    {freqLabel[kp.data.exam_frequency] ?? '低频'}
                  </Badge>
                </div>
              </a>
            ))}
          </div>
        </Card>
      );
    })}
  </div>
</BaseLayout>
