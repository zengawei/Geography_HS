---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const knowledgePoints = await getCollection('textbooks/knowledge');

// 按category分组
const categories = {
  natural: { name: '自然地理', color: 'green', points: [] },
  human: { name: '人文地理', color: 'blue', points: [] },
  regional: { name: '区域发展', color: 'amber', points: [] },
  world_china: { name: '世界与中国', color: 'purple', points: [] },
  tools: { name: '工具方法', color: 'rose', points: [] }
};

for (const kp of knowledgePoints) {
  const cat = kp.data.category;
  if (categories[cat]) {
    categories[cat].points.push(kp);
  }
}

const colorMap = {
  green: { bg: 'bg-green-50', text: 'text-green-700', border: 'border-green-200' },
  blue: { bg: 'bg-blue-50', text: 'text-blue-700', border: 'border-blue-200' },
  amber: { bg: 'bg-amber-50', text: 'text-amber-700', border: 'border-amber-200' },
  purple: { bg: 'bg-purple-50', text: 'text-purple-700', border: 'border-purple-200' },
  rose: { bg: 'bg-rose-50', text: 'text-rose-700', border: 'border-rose-200' }
};
---

<BaseLayout title="知识点总览">
  <h1 class="text-3xl font-bold mb-6">📖 知识点总览</h1>
  <p class="text-gray-600 mb-8">共 {knowledgePoints.length} 个核心知识点，按 5 大分类组织</p>

  <div class="space-y-8">
    {Object.entries(categories).map(([key, cat]) => {
      const colors = colorMap[cat.color];
      return (
        <section class={`rounded-lg border ${colors.border} p-6`}>
          <h2 class={`text-xl font-semibold mb-4 ${colors.text}`}>
            {cat.name}（{cat.points.length} 个）
          </h2>
          
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
            {cat.points.map(kp => (
              <a 
                href={`/Geography_HS/knowledge/${kp.id}/`}
                class={`block p-3 bg-white rounded border ${colors.border} hover:shadow-sm transition`}
              >
                <div class="font-medium text-gray-800">{kp.data.name}</div>
                <div class="text-xs text-gray-500 mt-1">{kp.data.name_en}</div>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>
