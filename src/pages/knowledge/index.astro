---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const knowledgePoints = await getCollection('knowledge-points');

// 按category分组
const byCategory = knowledgePoints.reduce((acc, kp) => {
  const category = kp.data.category;
  if (!acc[category]) acc[category] = [];
  acc[category].push(kp);
  return acc;
}, {});

const categoryInfo = {
  natural: { name: '自然地理', color: 'bg-green-100 text-green-700', icon: '🌿' },
  human: { name: '人文地理', color: 'bg-blue-100 text-blue-700', icon: '👥' },
  regional: { name: '区域发展', color: 'bg-amber-100 text-amber-700', icon: '🗺️' },
  world_china: { name: '世界与中国', color: 'bg-purple-100 text-purple-700', icon: '🌏' },
  tools: { name: '工具方法', color: 'bg-rose-100 text-rose-700', icon: '🧭' },
};
---

<BaseLayout title="知识点总览 — Geography_HS">
  <h1 class="text-3xl font-bold text-gray-900 mb-2">知识点总览</h1>
  <p class="text-gray-600 mb-8">共 {knowledgePoints.length} 个知识点，按五大类别组织</p>

  <div class="space-y-8">
    {Object.entries(categoryInfo).map(([key, info]) => {
      const kps = byCategory[key] || [];
      return (
        <section class="bg-white rounded-lg shadow border border-gray-100 p-6">
          <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2">
            <span class="text-3xl">{info.icon}</span>
            {info.name}
            <span class:list={['text-sm font-medium px-3 py-1 rounded-full ml-2', info.color]}>
              {kps.length} 个
            </span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {kps.map(kp => (
              <a
                href={`${import.meta.env.BASE_URL}/knowledge/${kp.data.id}`}
                class="block bg-gray-50 hover:bg-gray-100 rounded-lg p-4 border border-gray-200 transition"
              >
                <div class="font-semibold text-gray-900 mb-2">{kp.data.name}</div>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600 line-clamp-2">{kp.data.description.slice(0, 60)}...</span>
                  <span class:list={[
                    'px-2 py-1 rounded text-xs font-medium ml-2 flex-shrink-0',
                    kp.data.exam_frequency === 'high' ? 'bg-red-100 text-red-700' :
                    kp.data.exam_frequency === 'medium' ? 'bg-yellow-100 text-yellow-700' :
                    'bg-gray-100 text-gray-700'
                  ]}>
                    {kp.data.exam_frequency === 'high' ? '高频' :
                     kp.data.exam_frequency === 'medium' ? '中频' : '低频'}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>
