---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const knowledgePoints = await getCollection('knowledge-points');

const byCategory = knowledgePoints.reduce((acc, kp) => {
  const category = kp.data.category;
  if (!acc[category]) acc[category] = [];
  acc[category].push(kp);
  return acc;
}, {});

const topics = [
  { key: 'natural',      name: '自然地理',   icon: '🌿', border: 'border-green-200',  bg: 'bg-green-50',  text: 'text-green-700',  description: '大气、水文、地貌、土壤、植被等自然要素' },
  { key: 'human',        name: '人文地理',   icon: '👥', border: 'border-blue-200',   bg: 'bg-blue-50',   text: 'text-blue-700',   description: '人口、城市、农业、工业、交通等人文要素' },
  { key: 'regional',     name: '区域发展',   icon: '🗺️', border: 'border-amber-200',  bg: 'bg-amber-50',  text: 'text-amber-700',  description: '区域特征、区域发展、区域联系' },
  { key: 'world_china',  name: '世界与中国', icon: '🌏', border: 'border-purple-200', bg: 'bg-purple-50', text: 'text-purple-700', description: '世界地理、中国地理、全球问题' },
  { key: 'tools',        name: '工具方法',   icon: '🧭', border: 'border-rose-200',   bg: 'bg-rose-50',   text: 'text-rose-700',   description: '地图、GIS、地理计算方法' },
];
---

<BaseLayout title="专题模块 — Geography_HS">
  <h1 class="text-3xl font-bold text-content-title mb-2">专题模块</h1>
  <p class="text-content-muted mb-8">按主题纵向梳理地理知识，构建完整知识体系</p>

  <div class="space-y-6">
    {topics.map(topic => {
      const kps = byCategory[topic.key] || [];
      const highFreqCount = kps.filter(kp => kp.data.exam_frequency === 'high').length;

      return (
        <section class:list={['bg-surface-card rounded-card shadow-card border-2 p-6', topic.border]}>
          <div class="flex items-start justify-between mb-4">
            <div>
              <h2 class="text-2xl font-bold text-content-title mb-2 flex items-center gap-2">
                <span class="text-3xl">{topic.icon}</span>
                {topic.name}
              </h2>
              <p class="text-content">{topic.description}</p>
            </div>
            <div class="text-right flex-shrink-0 ml-4">
              <div class="text-3xl font-bold text-content-title">{kps.length}</div>
              <div class="text-sm text-content-muted">个知识点</div>
              {highFreqCount > 0 && (
                <div class="text-xs text-red-600 mt-1">🔥 {highFreqCount} 个高频</div>
              )}
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
            {kps.map((kp, idx) => (
              <a href={`${import.meta.env.BASE_URL}/knowledge/${kp.data.id}`}
                 class:list={[
                   'block bg-surface-card hover:bg-surface-hover rounded-card-sm p-3 border border-border transition text-sm',
                   idx >= 6 && 'hidden kp-extra'
                 ]}>
                <div class="font-semibold text-content-title mb-1">{kp.data.name}</div>
                <div class="text-xs text-content-muted line-clamp-1">{kp.data.description}</div>
              </a>
            ))}
          </div>

          {kps.length > 6 && (
            <div class="mt-4 text-center">
              <button class="toggle-btn text-sm text-brand-text hover:text-brand-hover cursor-pointer font-medium"
                      data-topic={topic.key}>
                展开显示全部 {kps.length} 个知识点 ▼
              </button>
            </div>
          )}
        </section>
      );
    })}
  </div>

  <section class="bg-brand-bg border border-brand-light rounded-card p-6 mt-8">
    <h2 class="text-xl font-bold text-content-title mb-3">💡 学习建议</h2>
    <ul class="space-y-2 text-content">
      <li>• <strong>系统学习</strong>：按专题顺序学习，建立完整知识框架</li>
      <li>• <strong>横向联系</strong>：注意不同专题之间的关联性</li>
      <li>• <strong>高频优先</strong>：优先掌握标记为"高频"的知识点</li>
      <li>• <strong>真题结合</strong>：每个知识点都关联了历年高考真题</li>
    </ul>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.toggle-btn').forEach(button => {
      button.addEventListener('click', () => {
        const section = button.closest('section');
        const extras = section.querySelectorAll('.kp-extra');
        const expanded = button.classList.contains('expanded');
        const total = extras.length + 6;

        extras.forEach(item => item.classList.toggle('hidden', expanded));
        button.textContent = expanded ? `展开显示全部 ${total} 个知识点 ▼` : '收起 ▲';
        button.classList.toggle('expanded', !expanded);
      });
    });
  });
</script>
