---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import StatBox from '../../components/StatBox.astro';
import Badge from '../../components/Badge.astro';
import { getCollection } from 'astro:content';

const nceeEntries = await getCollection('textbooks/ncee');
const activeEntries = nceeEntries.filter(entry => !entry.data.is_deprecated);

function getExamType(paperCode: string): { label: string; variant: string } {
  if (paperCode.includes('new-gao-kao')) return { label: '新高考', variant: 'exam-new' };
  if (paperCode.includes('quanguo'))     return { label: '全国卷', variant: 'exam-national' };
  return { label: '省级卷', variant: 'exam-provincial' };
}

const byYear = activeEntries.reduce((acc, entry) => {
  const year = entry.data.year;
  if (!acc[year]) acc[year] = new Map();
  const paperCode = entry.data.paper_code;
  if (!acc[year].has(paperCode)) {
    acc[year].set(paperCode, {
      paper: entry.data.paper,
      paper_code: paperCode,
      examType: getExamType(paperCode),
      questions: [],
    });
  }
  acc[year].get(paperCode).questions.push(entry);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
const totalQuestions = activeEntries.length;
const totalPapers = Object.values(byYear).reduce((sum, papers) => sum + papers.size, 0);
---

<BaseLayout title="高考地理真题 — Geography_HS">
  <h1 class="text-3xl font-bold text-content-title mb-2">高考地理真题</h1>
  <p class="text-content-muted mb-6">2012–2026，共 {totalQuestions} 道题目</p>

  <div class="grid grid-cols-3 gap-4 mb-8">
    <StatBox value={totalQuestions} label="道题目" color="green" />
    <StatBox value={totalPapers}   label="套试卷" color="blue" />
    <StatBox value={years.length}  label="个年份" color="amber" />
  </div>

  <div class="space-y-8">
    {years.map(year => {
      const papers = Array.from(byYear[year].values());
      return (
        <Card>
          <div class="flex items-center gap-3 mb-5">
            <span class="text-3xl">📅</span>
            <h2 class="text-2xl font-bold text-content-title">{year} 年</h2>
            <span class="text-sm font-normal text-content-muted">({papers.length} 套试卷)</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {papers.map(paper => (
              <a href={`${import.meta.env.BASE_URL}/ncee/${paper.paper_code}`}
                 class="block bg-surface hover:bg-surface-hover rounded-card-sm p-4 border border-border transition">
                <div class="font-semibold text-content-title mb-2">{paper.paper}</div>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-content-muted">{paper.questions.length} 道题</span>
                  <Badge variant={paper.examType.variant as any}>{paper.examType.label}</Badge>
                </div>
              </a>
            ))}
          </div>
        </Card>
      );
    })}
  </div>

  <div class="mt-8 p-4 bg-callout-warning-bg border border-callout-warning-border rounded-card-lg">
    <p class="text-sm text-callout-warning-text">
      ⚠️ 所有题目基于训练数据回忆，需对照官方试卷校对。如有错误，欢迎指正。
    </p>
  </div>
</BaseLayout>
