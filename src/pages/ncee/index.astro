---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const nceeEntries = await getCollection('textbooks/ncee');

// 过滤掉废弃的题目
const activeEntries = nceeEntries.filter(entry => !entry.data.is_deprecated);

// 从 paper_code 推断考试类型
function getExamType(paperCode: string): { label: string; color: string } {
  if (paperCode.includes('new-gao-kao')) {
    return { label: '新高考', color: 'bg-blue-100 text-blue-700' };
  }
  if (paperCode.includes('quanguo')) {
    return { label: '全国卷', color: 'bg-green-100 text-green-700' };
  }
  // 省级卷
  return { label: '省级卷', color: 'bg-purple-100 text-purple-700' };
}

// 按年份分组
const byYear = activeEntries.reduce((acc, entry) => {
  const year = entry.data.year;
  if (!acc[year]) acc[year] = new Map();

  const paperCode = entry.data.paper_code;
  if (!acc[year].has(paperCode)) {
    acc[year].set(paperCode, {
      paper: entry.data.paper,
      paper_code: paperCode,
      examType: getExamType(paperCode),
      questions: [],
    });
  }
  acc[year].get(paperCode).questions.push(entry);
  return acc;
}, {});

// 按年份排序（降序）
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

// 统计数据
const totalQuestions = activeEntries.length;
const totalPapers = Object.values(byYear).reduce((sum, papers) => sum + papers.size, 0);
---

<BaseLayout title="高考地理真题 — Geography_HS">
  <h1 class="text-3xl font-bold text-gray-900 mb-2">高考地理真题</h1>
  <p class="text-gray-600 mb-6">2012–2026，共 {totalQuestions} 道题目</p>

  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="bg-green-50 rounded-lg p-4 text-center">
      <div class="text-3xl font-bold text-green-700">{totalQuestions}</div>
      <div class="text-gray-600">道题目</div>
    </div>
    <div class="bg-blue-50 rounded-lg p-4 text-center">
      <div class="text-3xl font-bold text-blue-700">{totalPapers}</div>
      <div class="text-gray-600">套试卷</div>
    </div>
    <div class="bg-amber-50 rounded-lg p-4 text-center">
      <div class="text-3xl font-bold text-amber-700">{years.length}</div>
      <div class="text-gray-600">个年份</div>
    </div>
  </div>

  <div class="space-y-8">
    {years.map(year => {
      const papers = Array.from(byYear[year].values());
      return (
        <section class="bg-white rounded-lg shadow border border-gray-100 p-6">
          <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2">
            <span class="text-3xl">📅</span>
            {year} 年
            <span class="text-sm font-normal text-gray-500">({papers.length} 套试卷)</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {papers.map(paper => (
              <a
                href={`${import.meta.env.BASE_URL}/ncee/${paper.paper_code}`}
                class="block bg-gray-50 hover:bg-gray-100 rounded-lg p-4 border border-gray-200 transition"
              >
                <div class="font-semibold text-gray-900 mb-2">{paper.paper}</div>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">{paper.questions.length} 道题</span>
                  <span class:list={['px-2 py-1 rounded text-xs font-medium', paper.examType.color]}>
                    {paper.examType.label}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>

  <div class="mt-8 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
    <p class="text-sm text-yellow-800">
      ⚠️ 所有题目基于训练数据回忆，需对照官方试卷校对。如有错误，欢迎指正。
    </p>
  </div>
</BaseLayout>
