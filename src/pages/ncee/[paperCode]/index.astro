---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Badge from '../../../components/Badge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const nceeQuestions = await getCollection('textbooks/ncee');

  const papers: Record<string, any> = {};
  for (const q of nceeQuestions) {
    const code = q.data.paper_code;
    if (!papers[code]) {
      papers[code] = {
        paperCode: code,
        paper: q.data.paper,
        year: q.data.year,
        region: q.data.region,
        questions: []
      };
    }
    papers[code].questions.push(q);
  }

  for (const code of Object.keys(papers)) {
    papers[code].questions.sort((a: any, b: any) => a.data.question_number - b.data.question_number);
  }

  return Object.values(papers).map(paper => ({
    params: { paperCode: paper.paperCode },
    props: { paper }
  }));
}

const { paper } = Astro.props;

const questionContents = await Promise.all(
  paper.questions.map(async (q: any) => {
    const { Content } = await render(q);
    return { question: q, Content };
  })
);

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${paper.paper} - 高考真题`}>
  <Breadcrumb items={[
    { label: '高考真题', href: `${base}/ncee/` },
    { label: paper.paper },
  ]} />

  <div class="bg-gradient-to-r from-green-50 to-blue-50 rounded-card p-6 mb-6 border border-border">
    <h1 class="text-3xl font-bold text-content-heading mb-2">{paper.paper}</h1>
    <div class="flex items-center gap-4 text-sm text-content-muted">
      <span>{paper.year}年</span>
      <span>·</span>
      <span>{paper.questions.length} 道题目</span>
    </div>
  </div>

  <div class="bg-surface-card rounded-card-sm border border-border p-4 mb-6">
    <h3 class="text-sm font-semibold text-content-heading mb-3">快速导航</h3>
    <div class="flex flex-wrap gap-2">
      {paper.questions.map((q: any) => (
        <a href={`#q${q.data.question_number}`}
           class="px-3 py-1 rounded-input text-sm bg-surface-hover text-content-heading hover:bg-green-100 hover:text-green-700 transition-colors">
          第{q.data.question_number}题
        </a>
      ))}
    </div>
  </div>

  <div class="space-y-6">
    {questionContents.map(({ question: q, Content }: any) => (
      <article id={`q${q.data.question_number}`} class="bg-surface-card rounded-card shadow-card border border-border overflow-hidden scroll-mt-4">
        <div class="bg-gradient-to-r from-surface to-surface-card px-6 py-4 border-b border-border">
          <div class="flex items-center justify-between flex-wrap gap-3">
            <div class="flex items-center gap-3">
              <span class="flex items-center justify-center w-10 h-10 rounded-full bg-green-100 text-green-700 font-bold text-lg">
                {q.data.question_number}
              </span>
              <div>
                <h2 class="text-lg font-semibold text-content-heading">第 {q.data.question_number} 题</h2>
                <p class="text-xs text-content-muted mt-0.5">
                  {q.data.question_type === 'choice' ? '选择题' :
                   q.data.question_type === 'comprehensive' ? '综合题' :
                   q.data.question_type === 'fill_blank' ? '填空题' : '选做题'}
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <Badge variant={`diff-${q.data.difficulty}` as any}>
                {q.data.difficulty === 'basic' ? '基础' : q.data.difficulty === 'medium' ? '中等' : '困难'}
              </Badge>
              <Badge variant="score">{q.data.score}分</Badge>
            </div>
          </div>
        </div>

        <div class="px-6 py-5">
          <div class="prose prose-sm max-w-none text-content leading-relaxed">
            <Content />
          </div>

          {q.data.knowledge_points.length > 0 && (
            <div class="mt-5 pt-5 border-t border-border-card">
              <div class="flex items-start gap-2 flex-wrap">
                <span class="text-xs text-content-muted mt-1">知识点：</span>
                <div class="flex flex-wrap gap-1.5">
                  {q.data.knowledge_points.map((kpId: string) => (
                    <a href={`${base}/knowledge/${kpId}/`}
                       class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs bg-surface-hover text-content-muted hover:bg-green-100 hover:text-green-700 transition-colors">
                      {kpId}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          )}

          <div class="mt-4 pt-4 border-t border-border-card">
            <a href={`${base}/ncee/${q.data.paper_code}/${String(q.data.question_number).padStart(2, '0')}/`}
               class="inline-flex items-center text-sm text-green-600 hover:text-green-700 font-medium">
              查看题目详情
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-8 text-center">
    <a href="#"
       class="inline-flex items-center px-4 py-2 bg-surface-card border border-border-strong rounded-card text-content-heading hover:bg-surface-hover transition-colors">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
      返回顶部
    </a>
  </div>
</BaseLayout>
