---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const nceeQuestions = await getCollection('textbooks/ncee');
  
  return nceeQuestions.map(q => ({
    params: { 
      paperCode: q.data.paper_code,
      questionNum: String(q.data.question_number).padStart(2, '0')
    },
    props: { question: q }
  }));
}

const { question } = Astro.props;
const { Content } = await render(question);
---

<BaseLayout title={`第${question.data.question_number}题 - ${question.data.paper}`}>
  <nav class="text-sm text-gray-500 mb-4 flex items-center flex-wrap gap-2">
    <a href="/Geography_HS/ncee/" class="hover:text-green-600">高考真题</a>
    <span class="text-gray-400">›</span>
    <a href={`/Geography_HS/ncee/${question.data.paper_code}/`} class="hover:text-green-600">{question.data.paper}</a>
    <span class="text-gray-400">›</span>
    <span class="text-gray-800">第{question.data.question_number}题</span>
  </nav>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <!-- 题目头部 -->
    <div class="bg-gradient-to-r from-green-50 to-blue-50 px-6 py-4 border-b border-gray-200">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h1 class="text-2xl font-bold text-gray-800 mb-2">
            第 {question.data.question_number} 题
          </h1>
          <p class="text-sm text-gray-600">{question.data.paper} · {question.data.year}年</p>
        </div>
        <div class="flex items-center gap-3">
          <span class={`px-3 py-1 rounded-full text-sm font-medium ${
            question.data.difficulty === 'basic' ? 'bg-green-100 text-green-700' :
            question.data.difficulty === 'medium' ? 'bg-amber-100 text-amber-700' :
            'bg-red-100 text-red-700'
          }`}>
            {question.data.difficulty === 'basic' ? '基础' : 
             question.data.difficulty === 'medium' ? '中等' : '困难'}
          </span>
          <span class="px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-700">
            {question.data.score}分
          </span>
        </div>
      </div>
    </div>

    <!-- 题目内容 -->
    <div class="px-6 py-6">
      <div class="prose prose-sm max-w-none mb-6">
        <Content />
      </div>

      <!-- 知识点标签 -->
      {question.data.knowledge_points.length > 0 && (
        <div class="mt-6 pt-6 border-t border-gray-200">
          <h3 class="text-sm font-semibold text-gray-700 mb-3">相关知识点</h3>
          <div class="flex flex-wrap gap-2">
            {question.data.knowledge_points.map(kpId => (
              <a 
                href={`/Geography_HS/knowledge/${kpId}/`}
                class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-gray-100 text-gray-700 hover:bg-green-100 hover:text-green-700 transition-colors"
              >
                {kpId}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- 导航按钮 -->
  <div class="mt-6 flex justify-between">
    {question.data.question_number > 1 && (
      <a 
        href={`/Geography_HS/ncee/${question.data.paper_code}/${String(question.data.question_number - 1).padStart(2, '0')}/`}
        class="px-4 py-2 bg-white border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors"
      >
        ← 上一题
      </a>
    )}
    <div class="flex-1"></div>
    <a 
      href={`/Geography_HS/ncee/${question.data.paper_code}/`}
      class="px-4 py-2 bg-white border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors"
    >
      返回试卷
    </a>
  </div>
</BaseLayout>
