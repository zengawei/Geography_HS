---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import Badge from '../../../../components/Badge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const nceeQuestions = await getCollection('textbooks/ncee');

  return nceeQuestions.map(q => ({
    params: {
      paperCode: q.data.paper_code,
      questionNum: String(q.data.question_number).padStart(2, '0')
    },
    props: { question: q }
  }));
}

const { question } = Astro.props;
const { Content } = await render(question);

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`第${question.data.question_number}题 - ${question.data.paper}`}>
  <Breadcrumb items={[
    { label: '高考真题', href: `${base}/ncee/` },
    { label: question.data.paper, href: `${base}/ncee/${question.data.paper_code}/` },
    { label: `第${question.data.question_number}题` },
  ]} />

  <div class="bg-surface-card rounded-card shadow-card border border-border overflow-hidden">
    <div class="bg-gradient-to-r from-green-50 to-blue-50 px-6 py-4 border-b border-border">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h1 class="text-2xl font-bold text-content-heading mb-2">第 {question.data.question_number} 题</h1>
          <p class="text-sm text-content-muted">{question.data.paper} · {question.data.year}年</p>
        </div>
        <div class="flex items-center gap-3">
          <Badge variant={`diff-${question.data.difficulty}` as any}>
            {question.data.difficulty === 'basic' ? '基础' : question.data.difficulty === 'medium' ? '中等' : '困难'}
          </Badge>
          <Badge variant="score">{question.data.score}分</Badge>
        </div>
      </div>
    </div>

    <div class="px-6 py-6">
      <div class="prose prose-sm max-w-none mb-6">
        <Content />
      </div>

      {question.data.knowledge_points.length > 0 && (
        <div class="mt-6 pt-6 border-t border-border">
          <h3 class="text-sm font-semibold text-content-heading mb-3">相关知识点</h3>
          <div class="flex flex-wrap gap-2">
            {question.data.knowledge_points.map((kpId: string) => (
              <a href={`${base}/knowledge/${kpId}/`}
                 class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-surface-hover text-content-heading hover:bg-green-100 hover:text-green-700 transition-colors">
                {kpId}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  <div class="mt-6 flex justify-between">
    {question.data.question_number > 1 && (
      <a href={`${base}/ncee/${question.data.paper_code}/${String(question.data.question_number - 1).padStart(2, '0')}/`}
         class="px-4 py-2 bg-surface-card border border-border-strong rounded-card text-content-heading hover:bg-surface-hover transition-colors">
        ← 上一题
      </a>
    )}
    <div class="flex-1"></div>
    <a href={`${base}/ncee/${question.data.paper_code}/`}
       class="px-4 py-2 bg-surface-card border border-border-strong rounded-card text-content-heading hover:bg-surface-hover transition-colors">
      返回试卷
    </a>
  </div>
</BaseLayout>
