---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatBox from '../components/StatBox.astro';

const base = import.meta.env.BASE_URL;

const cards = [
  { title: '知识点',   count: '74个',     description: '覆盖自然地理、人文地理、区域发展等五大类别',       href: `${base}/knowledge`, accent: 'bg-blue-500' },
  { title: '高考真题', count: '2012-2026', description: '全国卷 + 主要省份，逐题解析与知识点关联',         href: `${base}/ncee`,      accent: 'bg-emerald-500' },
  { title: '专题模块', count: '5大专题',   description: '按主题纵向梳理，构建完整知识体系',               href: `${base}/topics`,    accent: 'bg-amber-500' },
  { title: '关于项目', count: '',          description: '了解 Geography_HS 项目的目标与技术栈',           href: `${base}/about`,     accent: 'bg-purple-500' },
];
---

<BaseLayout title="首页 — Geography_HS">
  <section class="text-center py-12">
    <h1 class="text-4xl font-bold text-content-title mb-4">欢迎来到 Geography_HS</h1>
    <p class="text-lg text-content-muted max-w-2xl mx-auto">
      基于人教版 2019 教材，覆盖 2012–2026 高考地理真题的高中地理知识库。
      帮助你系统梳理知识点、深入理解真题、高效备考。
    </p>
  </section>

  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pb-12">
    {cards.map((card) => (
      <a href={card.href} class="block bg-surface-card rounded-card shadow-card hover:shadow-card-hover transition p-6 border border-border-card">
        <div class:list={['w-10 h-10 rounded-card-sm mb-4', card.accent]} />
        <h2 class="text-lg font-semibold text-content-title mb-1">
          {card.title}
          {card.count && <span class="ml-2 text-sm font-normal text-content-muted">{card.count}</span>}
        </h2>
        <p class="text-sm text-content-muted">{card.description}</p>
      </a>
    ))}
  </section>

  <section class="text-center pb-12">
    <h2 class="text-2xl font-semibold text-content-title mb-6">知识体系概览</h2>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 max-w-4xl mx-auto text-sm">
      <StatBox value="26" label="自然地理"   color="green" />
      <StatBox value="14" label="人文地理"   color="blue" />
      <StatBox value="14" label="区域发展"   color="amber" />
      <StatBox value="12" label="世界与中国" color="purple" />
      <StatBox value="8"  label="工具方法"   color="rose" />
    </div>
  </section>
</BaseLayout>
