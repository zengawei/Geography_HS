---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const cards = [
  {
    title: '知识点',
    count: '74个',
    description: '覆盖自然地理、人文地理、区域发展等五大类别',
    href: `${base}/knowledge`,
    color: 'bg-blue-500',
  },
  {
    title: '高考真题',
    count: '2012-2026',
    description: '全国卷 + 主要省份，逐题解析与知识点关联',
    href: `${base}/ncee`,
    color: 'bg-emerald-500',
  },
  {
    title: '专题模块',
    count: '5大专题',
    description: '按主题纵向梳理，构建完整知识体系',
    href: `${base}/topics`,
    color: 'bg-amber-500',
  },
  {
    title: '关于项目',
    count: '',
    description: '了解 Geography_HS 项目的目标与技术栈',
    href: `${base}/about`,
    color: 'bg-purple-500',
  },
];
---

<BaseLayout title="首页 — Geography_HS">
  <section class="text-center py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">欢迎来到 Geography_HS</h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
      基于人教版 2019 教材，覆盖 2012–2026 高考地理真题的高中地理知识库。
      帮助你系统梳理知识点、深入理解真题、高效备考。
    </p>
  </section>

  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pb-12">
    {cards.map((card) => (
      <a
        href={card.href}
        class="block bg-white rounded-lg shadow hover:shadow-md transition p-6 border border-gray-100"
      >
        <div class:list={['w-10 h-10 rounded-lg mb-4', card.color]} />
        <h2 class="text-lg font-semibold text-gray-900 mb-1">
          {card.title}
          {card.count && (
            <span class="ml-2 text-sm font-normal text-gray-500">{card.count}</span>
          )}
        </h2>
        <p class="text-sm text-gray-600">{card.description}</p>
      </a>
    ))}
  </section>

  <section class="text-center pb-12">
    <h2 class="text-2xl font-semibold mb-6">知识体系概览</h2>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 max-w-4xl mx-auto text-sm">
      <div class="p-4 bg-green-50 rounded-lg">
        <div class="text-2xl font-bold text-green-700">26</div>
        <div class="text-gray-600">自然地理</div>
      </div>
      <div class="p-4 bg-blue-50 rounded-lg">
        <div class="text-2xl font-bold text-blue-700">14</div>
        <div class="text-gray-600">人文地理</div>
      </div>
      <div class="p-4 bg-amber-50 rounded-lg">
        <div class="text-2xl font-bold text-amber-700">14</div>
        <div class="text-gray-600">区域发展</div>
      </div>
      <div class="p-4 bg-purple-50 rounded-lg">
        <div class="text-2xl font-bold text-purple-700">12</div>
        <div class="text-gray-600">世界与中国</div>
      </div>
      <div class="p-4 bg-rose-50 rounded-lg">
        <div class="text-2xl font-bold text-rose-700">8</div>
        <div class="text-gray-600">工具方法</div>
      </div>
    </div>
  </section>
</BaseLayout>
