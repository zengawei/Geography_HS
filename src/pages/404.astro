---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在 — Geography_HS">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <p class="text-6xl mb-4">🌍</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">页面不存在</h1>
    <p class="text-gray-600 mb-8">你访问的页面不存在或已被移除。</p>
    <a
      href={`${import.meta.env.BASE_URL}/`}
      class="inline-block bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition"
    >
      返回首页
    </a>
  </div>
</BaseLayout>
